        <mxCell id="title" value="&lt;b style=&quot;font-size: 15px;&quot;&gt;AWS DEFENSE-IN-DEPTH: CHAINED SECURITY GROUPS ARCHITECTURE&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#94a3b8&quot; style=&quot;font-size: 11px;&quot;&gt;Principle of Least Privilege Network Isolation (huylam-alb-sg -&amp;gt; huylam-web-sg)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=none;fontColor=#ffffff;align=center;verticalAlign=middle;" vertex="1" parent="1">
