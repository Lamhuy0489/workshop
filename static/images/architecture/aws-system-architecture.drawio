          <mxGeometry x="20" y="120" width="230" height="70" as="geometry" />
        </mxCell>

        <!-- Target Group -->
        <mxCell id="tg" value="&lt;b&gt;Target Group: huylam-ocr-tg&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot; style=&quot;font-size: 10px;&quot;&gt;Port 5000 (HTTP 200 OK: /login)&lt;br&gt;&lt;font color=&quot;#059669&quot;&gt;&lt;b&gt;Healthy 1/1 (Live)&lt;/b&gt;&lt;/font&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#10b981;strokeWidth=1.5;fillColor=#ffffff;fontColor=#047857;fontSize=11;" vertex="1" parent="subnets">
          <mxGeometry x="20" y="230" width="230" height="60" as="geometry" />
        </mxCell>

        <!-- Application Tier / EC2 Box -->
        <mxCell id="app_tier" value="&lt;b&gt;Application Tier (Chained Security)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#0284c7&quot; style=&quot;font-size: 10px;&quot;&gt;huylam-web-sg (Inbound: TCP 5000 from huylam-alb-sg ONLY)&lt;/font&gt;" style="swimlane;whiteSpace=wrap;html=1;rounded=1;strokeColor=#bae6fd;fillColor=#f0f9ff;fontColor=#0369a1;fontSize=11;startSize=38;" vertex="1" parent="vpc">
          <mxGeometry x="320" y="40" width="330" height="410" as="geometry" />
        </mxCell>

        <!-- EC2 Instance -->
        <mxCell id="ec2" value="&lt;b&gt;huylam-ocr-web-server&lt;/b&gt; (AL2023 / t2.micro)&lt;br&gt;&lt;font color=&quot;#059669&quot; style=&quot;font-size: 10px;&quot;&gt;&lt;b&gt;Status: running (10.0.8.15)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;hr&gt;&lt;div style=&quot;text-align: left; font-size: 10px;&quot;&gt;&amp;bull; &lt;b&gt;Gunicorn WSGI&lt;/b&gt; (huylam-ocr.service)&lt;br&gt;&amp;bull; &lt;b&gt;Tier 1&lt;/b&gt;: Fast-Path Native (PyMuPDF: 0.1s - 0.3s)&lt;br&gt;&amp;bull; &lt;b&gt;Tier 2&lt;/b&gt;: Selective Vision OCR &amp;amp; Translation&lt;br&gt;&amp;bull; &lt;b&gt;Exporters&lt;/b&gt;: Word (.docx), Markdown (.md), PDF&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#ea580c;strokeWidth=2;fillColor=#ffffff;fontColor=#1e293b;fontSize=11;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="app_tier">
          <mxGeometry x="15" y="50" width="300" height="150" as="geometry" />
        </mxCell>

        <!-- Right Side: AWS S3 -->
        <mxCell id="s3" value="&lt;b&gt;Amazon Simple Storage Service (S3)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748b&quot; style=&quot;font-size: 10px;&quot;&gt;huylam-ocr-documents-ap-southeast-1&lt;/font&gt;&lt;br&gt;&lt;hr&gt;&lt;div style=&quot;text-align: left; font-size: 10px;&quot;&gt;&amp;bull; &lt;b&gt;uploads/&lt;/b&gt;: Raw PDF / Scan Files (CORS Web Direct)&lt;br&gt;&amp;bull; &lt;b&gt;outputs/&lt;/b&gt;: Parsed .md, .docx, .pdf (SSE-S3 AES-256)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#16a34a;strokeWidth=2;fillColor=#ffffff;fontColor=#1e293b;fontSize=11;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="aws_cloud">
          <mxGeometry x="750" y="50" width="380" height="130" as="geometry" />
        </mxCell>

        <!-- Right Side: AWS Lambda -->
        <mxCell id="lambda" value="&lt;b&gt;AWS Lambda (Serverless Event Processor)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748b&quot; style=&quot;font-size: 10px;&quot;&gt;huylam-ocr-processor (Python 3.11)&lt;/font&gt;&lt;br&gt;&lt;hr&gt;&lt;div style=&quot;text-align: left; font-size: 10px;&quot;&gt;&amp;bull; &lt;b&gt;Trigger&lt;/b&gt;: s3:ObjectCreated:* on uploads/ prefix&lt;br&gt;&amp;bull; &lt;b&gt;Latency&lt;/b&gt;: 214 ms | &lt;b&gt;Memory&lt;/b&gt;: 88 MB | &lt;b&gt;Cost&lt;/b&gt;: 0.00 USD&lt;br&gt;&amp;bull; &lt;b&gt;Role&lt;/b&gt;: huylam-ocr-lambda-role&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#ea580c;strokeWidth=2;fillColor=#ffffff;fontColor=#1e293b;fontSize=11;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="aws_cloud">
          <mxGeometry x="750" y="210" width="380" height="130" as="geometry" />
        </mxCell>

        <!-- Right Side: DynamoDB -->
        <mxCell id="ddb" value="&lt;b&gt;Amazon DynamoDB NoSQL&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748b&quot; style=&quot;font-size: 10px;&quot;&gt;Table: document_processing_jobs&lt;/font&gt;&lt;br&gt;&lt;hr&gt;&lt;div style=&quot;text-align: left; font-size: 10px;&quot;&gt;&amp;bull; &lt;b&gt;PK&lt;/b&gt;: job_id (String) | &lt;b&gt;SK&lt;/b&gt;: created_at (ISO 8601)&lt;br&gt;&amp;bull; &lt;b&gt;Billing&lt;/b&gt;: PAY_PER_REQUEST (On-Demand Mode)&lt;br&gt;&amp;bull; &lt;b&gt;Stores&lt;/b&gt;: Job Metadata, Processing Status, Latency&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2563eb;strokeWidth=2;fillColor=#ffffff;fontColor=#1e293b;fontSize=11;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="aws_cloud">
          <mxGeometry x="750" y="370" width="380" height="130" as="geometry" />
        </mxCell>

        <!-- Bottom Row: SSM -->
        <mxCell id="ssm" value="&lt;b&gt;AWS Systems Manager&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748b&quot; style=&quot;font-size: 10px;&quot;&gt;Parameter Store &amp;amp; Session Manager&lt;/font&gt;&lt;br&gt;&lt;hr&gt;&lt;div style=&quot;text-align: left; font-size: 10px;&quot;&gt;&amp;bull; &lt;b&gt;Parameter&lt;/b&gt;: /huylam-ocr/config (SecureString KMS)&lt;br&gt;&amp;bull; &lt;b&gt;Session Manager&lt;/b&gt;: Port-free Zero-SSH Remote Access&lt;br&gt;&amp;bull; &lt;b&gt;Security&lt;/b&gt;: 100% Zero Hardcoded Secrets&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#c026d3;strokeWidth=1.5;fillColor=#ffffff;fontColor=#1e293b;fontSize=11;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="aws_cloud">
