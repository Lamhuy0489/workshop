        </mxCell>

        <!-- IGW -->
        <mxCell id="igw" value="&lt;b&gt;Internet Gateway&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748b&quot; style=&quot;font-size: 10px;&quot;&gt;Route: 0.0.0.0/0 -&amp;gt; igw&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#8c4fff;strokeWidth=1.5;fillColor=#ffffff;fontColor=#1e293b;fontSize=11;" vertex="1" parent="subnets">
          <mxGeometry x="20" y="50" width="230" height="46" as="geometry" />
        </mxCell>

        <!-- ALB -->
