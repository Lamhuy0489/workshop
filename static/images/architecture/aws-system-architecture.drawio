        <!-- EC2 Details Card -->
        <mxCell id="ec2_details" value="&lt;b&gt;Gunicorn WSGI Daemon&lt;/b&gt; (huylam-ocr.service)&lt;br&gt;&lt;hr&gt;&lt;div style=&quot;text-align: left; font-size: 10px;&quot;&gt;&amp;bull; &lt;b&gt;Fast-Path Native&lt;/b&gt;: PyMuPDF (0.1s - 0.3s/page, $0.00)&lt;br&gt;&amp;bull; &lt;b&gt;Selective OCR&lt;/b&gt;: Qwen2.5-VL via Cloudflare Tunnel&lt;br&gt;&amp;bull; &lt;b&gt;Translation&lt;/b&gt;: Preserves Markdown Tables &amp;amp; Formulas&lt;br&gt;&amp;bull; &lt;b&gt;Outputs&lt;/b&gt;: Export Word (.docx), Markdown (.md), PDF&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#fed7aa;strokeWidth=1.5;fillColor=#ffffff;fontColor=#1e293b;fontSize=10;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="app_tier">
