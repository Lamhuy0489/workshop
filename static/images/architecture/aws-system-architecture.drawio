        </mxCell>

        <!-- Bottom Row: CloudWatch -->
        <mxCell id="cw" value="&lt;b&gt;Amazon CloudWatch&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748b&quot; style=&quot;font-size: 10px;&quot;&gt;Unified Logs, Metrics &amp;amp; Alarms&lt;/font&gt;&lt;br&gt;&lt;hr&gt;&lt;div style=&quot;text-align: left; font-size: 10px;&quot;&gt;&amp;bull; &lt;b&gt;Log Group&lt;/b&gt;: /aws/lambda/huylam-ocr-processor&lt;br&gt;&amp;bull; &lt;b&gt;Metrics&lt;/b&gt;: CPUUtilization, NetworkIn, HealthyHostCount&lt;br&gt;&amp;bull; &lt;b&gt;Alerts&lt;/b&gt;: CloudWatch Alarms + SNS Notifications&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#e11d48;strokeWidth=1.5;fillColor=#ffffff;fontColor=#1e293b;fontSize=11;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="aws_cloud">
