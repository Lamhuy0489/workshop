  <diagram id="aws-hybrid-engine" name="AWS Hybrid OCR Engine Architecture">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="&lt;b style=&quot;font-size: 16px;&quot;&gt;HYBRID MULTI-TIER DOCUMENT OCR &amp;amp; TECHNICAL TRANSLATION ENGINE&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#94a3b8&quot; style=&quot;font-size: 11px;&quot;&gt;Intelligent Fast-Path Vector Parsing with FinOps GPU &amp;amp; AWS Native Model Dispatcher&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=none;fontColor=#ffffff;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="30" width="1380" height="50" as="geometry" />
        </mxCell>

        <!-- Frontend Web Studio -->
        <mxCell id="web_studio" value="&lt;b&gt;Web Studio Frontend (SPA)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot; style=&quot;font-size: 10px;&quot;&gt;Drag &amp;amp; Drop PDF / Scanned Docs&lt;br&gt;Model Selection Dropdown&lt;br&gt;Bilingual Split-View Interface&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#0284c7;strokeWidth=2;fillColor=#ffffff;fontSize=12;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="60" y="130" width="220" height="120" as="geometry" />
        </mxCell>

        <!-- Backend Core -->
        <mxCell id="backend_box" value="Backend Processing Engine (EC2 AL2023 | hybrid_engine.py)" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.groupCenter;grIcon=mxgraph.aws4.group_aws_cloud;strokeColor=#334155;fillColor=#F8FAFC;verticalAlign=top;align=left;spacingLeft=30;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="320" y="100" width="1120" height="780" as="geometry" />
        </mxCell>

        <!-- Tier 1 -->
        <mxCell id="t1_box" value="&lt;b&gt;Tier 1: Fast-Path Native Vector Parser (PyMuPDF)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#15803d&quot; style=&quot;font-size: 11px;&quot;&gt;&lt;b&gt;0.1s - 0.3s / page | $0.00 Cost (Pure CPU Vector)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot; style=&quot;font-size: 10px;&quot;&gt;Direct digital text extraction for 80%+ documents&lt;br&gt;Preserves heading levels, tables, formatting&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#16a34a;strokeWidth=2;fillColor=#ffffff;fontSize=12;align=left;spacingLeft=15;verticalAlign=middle;" vertex="1" parent="backend_box">
          <mxGeometry x="30" y="50" width="460" height="110" as="geometry" />
        </mxCell>

        <!-- Tier 2 -->
        <mxCell id="t2_box" value="&lt;b&gt;Tier 2: Selective OCR Dispatcher (ocr_dispatcher.py)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#ea580c&quot; style=&quot;font-size: 11px;&quot;&gt;&lt;b&gt;Selective Scanned Page Rendering (300 DPI)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot; style=&quot;font-size: 10px;&quot;&gt;Branch A: Kaggle GPU 2x T4 32GB (Qwen2.5-VL-7B) + Gemini Failover&lt;br&gt;Branch B: Amazon Bedrock (Nova Micro/Claude) + Textract&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#ea580c;strokeWidth=2;fillColor=#ffffff;fontSize=12;align=left;spacingLeft=15;verticalAlign=middle;" vertex="1" parent="backend_box">
          <mxGeometry x="30" y="200" width="460" height="120" as="geometry" />
        </mxCell>

        <!-- Kaggle GPU Model Box -->
        <mxCell id="kaggle_box" value="&lt;b&gt;Kaggle GPU Cluster (FinOps 0.00 USD)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#0369a1&quot; style=&quot;font-size: 10px;&quot;&gt;Hardware: 2x NVIDIA T4 (32GB VRAM)&lt;br&gt;Model: Qwen2.5-VL-7B-Instruct&lt;br&gt;Tunnel: Cloudflare trycloudflare HTTPS&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#0284c7;strokeWidth=1.5;fillColor=#F0F9FF;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="backend_box">
          <mxGeometry x="540" y="50" width="260" height="110" as="geometry" />
