          <mxGeometry x="540" y="200" width="550" height="120" as="geometry" />
        </mxCell>

        <!-- Storage & Exporters -->
        <mxCell id="s3_store_box" value="&lt;b&gt;Amazon S3 Outputs Lake (huylam-ocr-documents-ap-southeast-1)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#15803d&quot; style=&quot;font-size: 10px;&quot;&gt;outputs/{job_id}/: cv.pdf.md, cv.pdf.docx, cv.pdf.pdf (AES-256 SSE-S3)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#16a34a;strokeWidth=1.5;fillColor=#F0FDF4;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="backend_box">
          <mxGeometry x="30" y="360" width="500" height="80" as="geometry" />
